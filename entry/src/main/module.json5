{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "ManagerAbility",
    "srcEntry": "./ets/abilitystage/PaperTodoAbilityStage.ets",
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.WINDOW_TOPMOST"
      },
      {
        "name": "ohos.permission.SET_WINDOW_TRANSPARENT"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.PREPARE_APP_TERMINATE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "singleton",
        "supportWindowMode": [
          "floating"
        ],
        "excludeFromDock": true,
        "removeMissionAfterTerminate": true,
        "exported": false
      },
      {
        "name": "ManagerAbility",
        "srcEntry": "./ets/managerability/ManagerAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "singleton",
        "supportWindowMode": [
          "floating"
        ],
        "excludeFromDock": false,
        "removeMissionAfterTerminate": false,
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        "name": "TrayResidentAbility",
        "srcEntry": "./ets/trayresidentability/TrayResidentAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "singleton",
        "supportWindowMode": [
          "floating"
        ],
        "excludeFromDock": true,
        "removeMissionAfterTerminate": true,
        "exported": false
      },
      {
        "name": "PaperAbility",
        "srcEntry": "./ets/paperability/PaperAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "specified",
        "supportWindowMode": [
          "floating"
        ],
        "minWindowWidth": 40,
        "minWindowHeight": 46,
        "excludeFromDock": true,
        "removeMissionAfterTerminate": true,
        "exported": false
      },
      {
        "name": "EdgeCapsuleAbility",
        "srcEntry": "./ets/edgecapsuleability/EdgeCapsuleAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "specified",
        "supportWindowMode": [
          "floating"
        ],
        "minWindowWidth": 40,
        "minWindowHeight": 46,
        "excludeFromDock": true,
        "removeMissionAfterTerminate": true,
        "exported": false
      },
      {
        "name": "MasterCapsuleAbility",
        "srcEntry": "./ets/mastercapsuleability/MasterCapsuleAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindow": "$profile:hidden_start_window",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:paper_start_window_background",
        "launchType": "singleton",
        "supportWindowMode": [
          "floating"
        ],
        "minWindowWidth": 40,
        "minWindowHeight": 46,
        "excludeFromDock": true,
        "removeMissionAfterTerminate": true,
        "exported": false
      }
    ],
    "extensionAbilities": [
      {
        "name": "PaperStatusBarAbility",
        "icon": "$media:app_icon",
        "description": "$string:EntryAbility_desc",
        "type": "statusBarView",
        "exported": true,
        "srcEntry": "./ets/statusbarviewability/PaperStatusBarAbility.ets"
      }
    ]
  }
}
